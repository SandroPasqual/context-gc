{
  "name": "pi-context-gc",
  "version": "1.0.0",
  "description": "Incremental, narrative-preserving context garbage collection for Pi. Trims duplicate and invalidated tool output before the first LLM call of each run, while never touching user/assistant narrative or the recent turns of a turn.",
  "keywords": [
    "pi",
    "pi-agent",
    "pi-extension",
    "context-window",
    "token-optimization",
    "llm",
    "garbage-collection"
  ],
  "license": "MIT",
  "type": "module",
  "main": "src/context-gc.ts",
  "types": "src/context-gc.ts",
  "files": [
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "lint": "tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {},
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.3.0",
    "@earendil-works/pi-coding-agent": "^1.3.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "author": "Sandro Pasqual",
  "license": "MIT"
}
